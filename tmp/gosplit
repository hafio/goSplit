CREATE VIEW public.balance_view AS
 WITH pair AS (
         SELECT
                CASE
                    WHEN (ep.user_id < e.paid_by) THEN ep.user_id
                    ELSE e.paid_by
                END AS a,
                CASE
                    WHEN (ep.user_id < e.paid_by) THEN e.paid_by
                    ELSE ep.user_id
                END AS b,
            e.group_id,
            e.currency,
            (ep.amount *
                CASE
                    WHEN (ep.user_id < e.paid_by) THEN 1
                    ELSE '-1'::integer
                END) AS signed
           FROM (public.expense_participants ep
             JOIN public.expenses e ON ((e.id = ep.expense_id)))
          WHERE ((ep.user_id <> e.paid_by) AND (e.deleted_at IS NULL))
        )
 SELECT pair.a AS user_id,
    pair.b AS friend_id,
    pair.group_id,
    pair.currency,
    sum(pair.signed) AS amount
   FROM pair
  GROUP BY pair.a, pair.b, pair.group_id, pair.currency
UNION ALL
 SELECT pair.b AS user_id,
    pair.a AS friend_id,
    pair.group_id,
    pair.currency,
    (- sum(pair.signed)) AS amount
   FROM pair
