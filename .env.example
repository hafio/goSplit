# GoSplit configuration. Copy to .env and adjust. OAuth/OIDC is deliberately
# dropped — auth is magic-link + password only.

# --- core -----------------------------------------------------------------
BASE_URL=http://localhost:8080
ADDR=:8080
# REQUIRED. Generate: openssl rand -base64 32
SESSION_SECRET=
# Log verbosity: debug | info (default) | warn | error.
# Per-email send lines (mail: sending / mail: sent) are logged at debug.
LOG_LEVEL=info

# --- database -------------------------------------------------------------
# SQLite (default): a single file, no DB container.
# DATABASE_URL=file:./data/gosplit.db
# PostgreSQL (multi-instance / scale). Prefer the keyword/value DSN below: it
# needs no URL-encoding of special characters in the password (a postgres://
# URL would reject characters like [ ] ^ in the userinfo).
POSTGRES_CONTAINER_NAME="db-postgres"
POSTGRES_USER="xxx"
POSTGRES_PASSWORD="xxx"
POSTGRES_DB="xxx"
POSTGRES_PORT=5432
DATABASE_URL="host=${POSTGRES_CONTAINER_NAME} port=${POSTGRES_PORT} user=${POSTGRES_USER} password='${POSTGRES_PASSWORD}' dbname=${POSTGRES_DB} sslmode=disable"

UPLOAD_DIR=/data/uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# --- email (SMTP) ---------------------------------------------------------
# If EMAIL_SERVER_HOST is empty, magic-link/reset links are printed to the logs
# (handy for local dev).
FROM_EMAIL=gosplit@hafio.tv
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_TLS_REJECT_UNAUTHORIZED=true

# --- web push (VAPID) -----------------------------------------------------
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=

# --- currency rates -------------------------------------------------------
CURRENCY_RATE_PROVIDER=frankfurter
OPEN_EXCHANGE_RATES_APP_ID=

# --- bank sync (optional, Plaid) ------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_COUNTRY_CODES=US
PLAID_INTERVAL_IN_DAYS=30

# --- scheduler ------------------------------------------------------------
SCHEDULER=true
CLEAR_CACHE_CRON_RULE=0 3 * * *
CACHE_RETENTION_INTERVAL=720h

# --- backup / restore -----------------------------------------------------
# Archives hold EVERY table -- including password hashes, session tokens and
# bank data -- plus the upload tree. They are always encrypted, with a key
# derived from SESSION_SECRET. Rotating or losing that secret makes every
# existing archive permanently unrestorable, and there is no override key.
#
# Where `gosplit backup`, the admin panel and the scheduler write archives.
BACKUP_DIR=/data/backups
# 5-field cron rule (min hour dom mon dow), same dialect as expense
# recurrences. Empty disables scheduled backups. Requires BACKUP_DIR.
BACKUP_CRON=0 4 * * *
# Keep this many newest archives in BACKUP_DIR; older ones are pruned.
# Negative keeps everything; 0 is rejected, since it would mean "keep none".
BACKUP_RETENTION_COUNT=7
# Watched at startup. If it holds exactly one .gsbak and the marker file
# .gosplit-restored is ABSENT, that archive is restored and the marker written.
# Empty disables this. It must differ from BACKUP_DIR, or the instance would
# restore its own most recent scheduled backup on the next boot.
# Any failure here is fatal and aborts the boot, schema mismatch included --
# so a stale archive left behind will fail every restart until it is removed.
AUTO_RESTORE_DIR=
# Restore limits. These bound a file that could come from anywhere.
RESTORE_MAX_UPLOAD_MB=500
RESTORE_MAX_ARCHIVE_MB=2048
RESTORE_MAX_ENTRIES=200000
RESTORE_MAX_TABLE_FILE_MB=512
RESTORE_MAX_JSONL_LINE_MB=8

# --- feature gates / misc -------------------------------------------------
DISABLE_EMAIL_SIGNUP=true
ENABLE_SENDING_INVITES=true
DEFAULT_HOMEPAGE=/balances
# Comma-separated. Matching users are auto-promoted to ADMIN (never demoted).
ADMIN_EMAILS=gosplit@hafio.tv
FEEDBACK_EMAIL=gosplit@hafio.tv
DISCORD_WEBHOOK_URL=
