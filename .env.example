# GoSplit configuration. Copy to .env, set SESSION_SECRET, then load it into your
# shell with:  set -a; . ./.env; set +a   (the binary reads the environment only).
# Every value below is the built-in default unless the comment says otherwise.
# Full reference: docs/configuration.md

# --- core -----------------------------------------------------------------
# REQUIRED, at least 16 characters. Generate: openssl rand -base64 32
# Derives the encryption key for every backup archive. Keep the same value for
# the life of the instance: an archive is only restorable under the secret that
# made it. (Sessions are database rows, so rotating this logs nobody out.)
SESSION_SECRET=
# Public URL. An https:// prefix is what turns on the Secure cookie flag.
BASE_URL=http://localhost:8080
ADDR=:8080
# debug | info | warn | error. Anything else means info. With no SMTP host the
# log-only mailer prints every message, links included, at info.
LOG_LEVEL=info

# --- database -------------------------------------------------------------
# SQLite (default): one file, no database server. The file: prefix is required.
# The container image sets DATABASE_URL=file:/data/gosplit.db instead.
DATABASE_URL=file:./data/gosplit.db
# PostgreSQL, either form. The keyword DSN needs no URL-encoding of special
# characters in the password.
# DATABASE_URL="host=localhost port=5432 user=gosplit password=secret dbname=gosplit sslmode=disable"
# DATABASE_URL=postgres://gosplit:secret@localhost:5432/gosplit?sslmode=disable

# --- uploads (profile avatars) --------------------------------------------
# The container image sets UPLOAD_DIR=/data/uploads instead.
UPLOAD_DIR=./data/uploads
# Also the per-file cap a restore enforces on uploads inside an archive. A backup
# archives every file regardless of size, so lowering this below a file already
# archived makes that archive unrestorable until raised again.
UPLOAD_MAX_FILE_SIZE_MB=10

# --- email (SMTP) ---------------------------------------------------------
# With EMAIL_SERVER_HOST empty, sign-in and reset links are printed to the log.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_TLS_REJECT_UNAUTHORIZED=true
FROM_EMAIL=no-reply@gosplit.local

# --- web push (VAPID) -----------------------------------------------------
# Push is enabled when both keys are set. WEB_PUSH_EMAIL falls back to FROM_EMAIL.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=

# --- currency rates -------------------------------------------------------
# frankfurter (no key) | openexchangerates (needs the app id) | none (no live rates)
CURRENCY_RATE_PROVIDER=frankfurter
OPEN_EXCHANGE_RATES_APP_ID=

# --- bank sync (optional, Plaid) ------------------------------------------
# Enabled when both PLAID_CLIENT_ID and PLAID_SECRET are set.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production. Anything else means sandbox.
PLAID_ENVIRONMENT=sandbox
PLAID_COUNTRY_CODES=US
PLAID_INTERVAL_IN_DAYS=30

# --- scheduler ------------------------------------------------------------
# Recurring expenses, session/token/rate-cache cleanup and scheduled backups.
# Safe on every replica; leader locks keep each job to one.
SCHEDULER=true
# Accepted for SplitPro compatibility; not used. The rate-cache cleanup runs on
# every scheduler tick. Cron values contain spaces: keep them quoted.
CLEAR_CACHE_CRON_RULE="0 3 * * *"
CACHE_RETENTION_INTERVAL=720h

# --- backup / restore -----------------------------------------------------
# Archives hold EVERY table, password hashes and session tokens included, plus
# the upload tree. They are encrypted with a key derived from SESSION_SECRET;
# rotate or lose that secret and every existing archive is unrestorable.
# See docs/backup-restore.md.
#
# Where the CLI, the admin page and the scheduler write archives, and where an
# uploaded archive and the pre-restore safety dump are buffered. The container
# image does NOT set this: set BACKUP_DIR=/data/backups there, or the default
# lands outside the /data volume.
BACKUP_DIR=./data/backups
# 5-field cron rule (min hour dom mon dow), evaluated in UTC. Empty (the
# default) disables scheduled backups. Quote it: BACKUP_CRON="0 4 * * *"
BACKUP_CRON=
# Keep this many newest archives; older ones are pruned after each scheduled
# backup (nothing prunes without BACKUP_CRON). Negative keeps all; 0 is refused.
BACKUP_RETENTION_COUNT=7
# Watched at startup: exactly one .gsbak present and no .gosplit-restored marker
# means restore, then write the marker. Empty disables. Must be writable and
# must differ from BACKUP_DIR. Any restore failure aborts the boot until the
# file is removed.
AUTO_RESTORE_DIR=
# Limits on archives a restore will accept. All must be > 0.
RESTORE_MAX_UPLOAD_MB=500
RESTORE_MAX_ARCHIVE_MB=2048
RESTORE_MAX_ENTRIES=200000
RESTORE_MAX_TABLE_FILE_MB=512
RESTORE_MAX_JSONL_LINE_MB=8

# --- accounts and features ------------------------------------------------
# Comma-separated. Matching users are promoted to admin on sign-in, never demoted.
ADMIN_EMAILS=
# true closes self-service registration; admins create users instead.
DISABLE_EMAIL_SIGNUP=false
# false refuses adding a friend or member by an email that has no account yet.
ENABLE_SENDING_INVITES=true
DEFAULT_HOMEPAGE=/balances
# Accepted for SplitPro compatibility; not used by any feature yet.
FEEDBACK_EMAIL=
DISCORD_WEBHOOK_URL=
