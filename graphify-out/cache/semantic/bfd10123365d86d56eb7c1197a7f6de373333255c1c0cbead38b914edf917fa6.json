{"nodes": [{"id": "docs_ui_refresh_plan", "label": "GoSplit UI/UX Refresh Plan", "file_type": "document", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refresh GoSplit's functional-but-utilitarian UI toward the SplitPro/Splitwise interaction language while preserving the entire as-built server-rendered architecture; every phase is independently shippable."}, {"id": "docs_ui_refresh_plan_splitpro_language", "label": "SplitPro/Splitwise Interaction Language", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target UX idiom: big amount entry, icon pickers, avatar rows, and you-lent/you-owe color coding, replacing plain data tables and free-text inputs."}, {"id": "docs_ui_refresh_plan_theme_palette", "label": "Named Accent Theme Palette", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six named accents (burgundy, teal, indigo, forest, amber, slate), each with a designed light and dark variant; store the accent slug name, never a hex, so themes stay stable and DB-portable."}, {"id": "docs_ui_refresh_plan_burgundy_default", "label": "Burgundy Default Accent", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default accent changes from teal to a gentle burgundy; fresh and migrated DBs render burgundy by default."}, {"id": "docs_ui_refresh_plan_avatar_colors", "label": "Avatar Colors (Initials Circles)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic palette[userID % 6] with white text keeps a user's color stable; a real uploaded User.Image takes precedence over initials at the same size/shape."}, {"id": "docs_ui_refresh_plan_category_emoji_map", "label": "Category Emoji Map", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Categories stay free text in the DB; the picker offers canonical names and a box (package) fallback emoji for anything unknown so imported/legacy categories still render."}, {"id": "docs_ui_refresh_plan_icon_sprite", "label": "Icon Sprite (icons.svg)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One SVG symbol sheet of Lucide-style outline icons (24x24, stroke=currentColor), served from the embedded assets and used via use href=/static/icons.svg#id; no icon font or external dependency."}, {"id": "docs_ui_refresh_plan_semantic_colors", "label": "Semantic Amount Colors (--pos/--neg)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positive/negative money colors (green/red) stay independent of the accent so recoloring the theme never changes money semantics; the accent is never reused for pos/neg amounts."}, {"id": "docs_ui_refresh_plan_server_rendered_templates", "label": "Server-Rendered html/template Architecture", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the as-built Go stdlib html/template rendering (view.go, layout.html + partials.html); no SPA framework."}, {"id": "docs_ui_refresh_plan_handwritten_css", "label": "Hand-Written CSS (No Framework)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Tailwind or CSS framework; extend the existing compact hand-written app.css with CSS-variable usage."}, {"id": "docs_ui_refresh_plan_vanilla_js", "label": "Vanilla JS Enhancement (No Alpine)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "htmx already ships; add at most one small vanilla JS file (for the expense form), no Alpine."}, {"id": "docs_ui_refresh_plan_static_binary_embed", "label": "Single Static Binary (go:embed Assets)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All assets under internal/web/assets are embedded via go:embed assets/* and served from one static binary; no CDN, no build step, no new Go dependencies."}, {"id": "docs_ui_refresh_plan_frozen_contracts", "label": "Frozen Route/Form/Query Contracts", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes, form field names, and query-string contracts must not change; the only sanctioned data-layer additions are users.theme_color (Phase 2) and a per-row net share (Phase 4)."}, {"id": "docs_ui_refresh_plan_progressive_enhancement", "label": "Progressive Enhancement", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every interactive widget must degrade to working native controls (details, radios, checkboxes) without JS; CSS :has() is allowed."}, {"id": "docs_ui_refresh_plan_i18n_parity", "label": "i18n Key Parity (en + es)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every new user-visible string gets a key in both en.json and es.json, rendered via the existing {{.T key}}; the i18n test suite guards key parity."}, {"id": "docs_ui_refresh_plan_phase_1_foundation", "label": "Phase 1: Foundation (icons, helpers, CSS components)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No visible behavior change; adds the icon sprite, template helper funcs, and the CSS component library everything later builds on."}, {"id": "docs_ui_refresh_plan_phase_2_theme_color", "label": "Phase 2: Theme Color (user-selectable, burgundy default)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follows the preferred_language pattern end to end: migration, store column, theme registry, ViewData, layout meta tags, profile UI, allowlist-validated handler."}, {"id": "docs_ui_refresh_plan_phase_3_lists_nav", "label": "Phase 3: Lists & Navigation", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Template-only, reuses existing view data: avatar list rows, stat hero/tiles, icon bottom nav with active state, and a reusable empty-state partial."}, {"id": "docs_ui_refresh_plan_phase_4_expense_feed", "label": "Phase 4: Expense Feed (month groups, category icons, you lent/borrowed)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one phase with a store/handler change; adds the viewer's per-row net amount and month-grouped feed shape that all callers pick up automatically."}, {"id": "docs_ui_refresh_plan_phase_5_expense_form", "label": "Phase 5: Add-Expense Form", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuild expense_form.html with a frozen POST contract: native inputs styled by CSS plus one small JS enhancement; the no-JS path must fully work."}, {"id": "docs_ui_refresh_plan_phase_6_filter_bar", "label": "Phase 6: Filter Bar", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rework the filterbar partial with a frozen GET contract: search plus a details panel and server-rendered removable filter chips; zero JS."}, {"id": "docs_ui_refresh_plan_phase_7_detail_polish", "label": "Phase 7: Group Page & Detail Polish", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity headers, stat-hero position strips, overflow menus, avatar-to-avatar settlement rows, and receipt-style expense detail across group, expense detail, and friend pages."}, {"id": "docs_ui_refresh_plan_template_funcs", "label": "Template Helper Funcs (initials/avatarColor/categoryEmoji/categories)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extend the funcs FuncMap in view.go with pure display helpers, table-driven unit-tested including empty-name/email edge cases."}, {"id": "docs_ui_refresh_plan_css_component_library", "label": "CSS Component Library (app.css)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About 350 lines of new component classes (avatars, list rows, cards, segmented control, pills, chips, stat tiles, swatches, overflow menus) appended in the existing compact style, keeping the info-dense 15px scale."}, {"id": "docs_ui_refresh_plan_theme_registry", "label": "Theme Registry (theme.go)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered Themes slice, ValidTheme allowlist, DefaultTheme=burgundy, and themeHex func; validation is the central gate so the handler never accepts arbitrary theme strings."}, {"id": "docs_ui_refresh_plan_theme_swatch_picker", "label": "Theme Swatch Picker (Profile Appearance)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One styled radio per theme inside the existing profile details form; pure CSS :checked selection state, no JS."}, {"id": "docs_ui_refresh_plan_bottom_nav", "label": "Icon Bottom Navigation", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Icon + label per tab with a 46px FAB plus; the active tab is derived in Render by mapping page name to a nav slug exposed as ViewData.Nav."}, {"id": "docs_ui_refresh_plan_empty_state_partial", "label": "Empty State Partial", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New reusable partial taking Icon/Text/CTAHref/CTALabel, replacing bare muted paragraphs on friends, groups, balances, and activity."}, {"id": "docs_ui_refresh_plan_stat_hero", "label": "Stat Hero / Tiles", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Card showing per-currency net position with you-are-owed/you-owe tiles; never sum across currencies."}, {"id": "docs_ui_refresh_plan_month_grouped_feed", "label": "Month-Grouped Expense Feed", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrite of the expense_table partial as a month-grouped card feed with date blocks, category emoji tiles, and a you-lent/you-borrowed column; all callers adopt the new shape automatically."}, {"id": "docs_ui_refresh_plan_my_net_share", "label": "Per-Row My Net Share", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LEFT JOIN expense_participants on (expense_id, user_id=viewer); participants are stored zero-sum signed so the joined amount is already the net (positive lent, negative borrowed, NULL not involved). One of the two sanctioned data-layer additions."}, {"id": "docs_ui_refresh_plan_amount_hero", "label": "Amount Hero Input", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Big centered amount input (inputmode=decimal) with the currency chosen via a details picker whose panel is a radio list; radios post without JS."}, {"id": "docs_ui_refresh_plan_split_method_segmented", "label": "Split Method Segmented Control", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five split methods (EQUAL/EXACT/PERCENTAGE/SHARE/ADJUSTMENT) as a radio segmented control with glyph labels; per-method helper text swaps via CSS :has(), replacing the all-at-once legend."}, {"id": "docs_ui_refresh_plan_expense_form_js", "label": "Expense Form JS Enhancement (expense_form.js)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New vanilla file (<=150 lines, deferred, this page only) doing live equal-split preview, running sum hints, Today/Yesterday chips, and close-on-select; everything cosmetic, server-side validation stays authoritative."}, {"id": "docs_ui_refresh_plan_filter_chips", "label": "Server-Rendered Filter Chips (queryWithout)", "file_type": "concept", "source_file": "docs/ui-refresh-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active filters render as removable chip links via a queryWithout template func that rebuilds the URL minus one param; zero JS."}], "edges": [{"source": "docs_ui_refresh_plan", "target": "docs_ui_refresh_plan_splitpro_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ui-refresh-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_ui_refresh_plan", "target": "docs_ui_refresh_plan_theme_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ui-refresh-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_ui_refresh_plan", "target": "docs_ui_refresh_plan_avatar_colors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ui-refresh-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_ui_refresh_plan", "t