butor": null}, {"id": "splitpro_rebuild_spec_and_prompt_alternatives_considered", "label": "Alternatives considered (Phoenix, Rust/Axum)", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elixir/Phoenix LiveView (heavier runtime, less familiar) and Rust/Axum (fast but slower to build) rejected; Go + htmx wins on lightweight, easy, backend-heavy, trivially self-hostable."}, {"id": "splitpro_rebuild_spec_and_prompt_data_model", "label": "Data model (preserve current schema)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_user", "label": "User entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds NEW passwordHash; hiddenFriendIds stored as JSON text on SQLite; role USER|ADMIN; the Account entity is dropped with OAuth/OIDC."}, {"id": "splitpro_rebuild_spec_and_prompt_session", "label": "Session entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_verification_token", "label": "VerificationToken entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backs magic-link, email verification, and password reset."}, {"id": "splitpro_rebuild_spec_and_prompt_group", "label": "Group entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "publicId (nanoid) is the shareable join link; simplifyDebts flag; archivedAt; splitwiseGroupId."}, {"id": "splitpro_rebuild_spec_and_prompt_group_user", "label": "GroupUser (membership join)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_default_split", "label": "Group/FriendDefaultSplit", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default splits restricted to EQUAL, PERCENTAGE, SHARE."}, {"id": "splitpro_rebuild_spec_and_prompt_expense", "label": "Expense entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "int64 amount; soft-delete (deletedAt/deletedBy); conversionToId links a currency-conversion pair; movedFromId (NEW) links the replacement created by a move; recurrenceId; fileKey; transactionId."}, {"id": "splitpro_rebuild_spec_and_prompt_expense_participant", "label": "ExpenseParticipant entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed net amount (int64) per (expenseId, userId); rows sum to zero per expense."}, {"id": "splitpro_rebuild_spec_and_prompt_expense_recurrence", "label": "ExpenseRecurrence entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cronExpression, unique jobName, templateExpenseId, notified."}, {"id": "splitpro_rebuild_spec_and_prompt_scheduler_lock", "label": "SchedulerLock entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "id, holder, expiresAt - DB leader election for the in-process scheduler."}, {"id": "splitpro_rebuild_spec_and_prompt_cached_currency_rate", "label": "CachedCurrencyRate entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_cached_bank_data", "label": "CachedBankData entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_push_notification", "label": "PushNotification entity", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_balance_view", "label": "BalanceView (SQL VIEW)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical unordered user pair via CASE, signed sum of participant shares grouped by (pair, group, currency), UNION ALL both directions. Portable across SQLite and Postgres; get_balance_at_date() adds a date filter."}, {"id": "splitpro_rebuild_spec_and_prompt_split_engine", "label": "Split engine (\u00a75.1)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_equal", "label": "EQUAL split", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "share = total/n; remainder distributed one unit at a time via a deterministic seeded shuffle (seed from sorted amounts + expense date)."}, {"id": "splitpro_rebuild_spec_and_prompt_percentage", "label": "PERCENTAGE split", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Percentages in basis points (100% = 10000); share = pct*total/10000; must total 100%."}, {"id": "splitpro_rebuild_spec_and_prompt_exact", "label": "EXACT split", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each share entered directly; must sum to total."}, {"id": "splitpro_rebuild_spec_and_prompt_share", "label": "SHARE split", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer share units, GCD-normalized; share = units*total/sum(units)."}, {"id": "splitpro_rebuild_spec_and_prompt_adjustment", "label": "ADJUSTMENT split", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed per-person adjustment, remainder split equally: share = (total - sum(adj))/n + adj_i."}, {"id": "splitpro_rebuild_spec_and_prompt_settlement", "label": "SETTLEMENT (settle-up)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System method stored as an expense with splitType=SETTLEMENT; excluded from category/expense filters; drives balances toward zero; movable."}, {"id": "splitpro_rebuild_spec_and_prompt_currency_conversion", "label": "CURRENCY_CONVERSION", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System method: converts a balance by creating a linked pair of expenses (conversionFrom/conversionTo) joined by conversionToId; the pair is not movable."}, {"id": "splitpro_rebuild_spec_and_prompt_zero_sum_convention", "label": "Zero-sum signed participant convention", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74.1 / \u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payer stored as +(total - share), everyone else as -(share), so rows sum to zero. The whole correctness of BalanceView rests on writers enforcing this - enforce and unit-test it."}, {"id": "splitpro_rebuild_spec_and_prompt_debt_simplification", "label": "Debt simplification (min-cash-flow)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a74.1 / \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Greedy min-cash-flow preserves each node's per-currency net while minimizing transactions; no participant both pays and receives."}, {"id": "splitpro_rebuild_spec_and_prompt_filtering", "label": "Filtering (\u00a75.2)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query-only, AND-combined; group scope, amount range, date range, description with * wildcard via lower(name) LIKE lower(pattern) (escaped %/_) so it behaves identically on SQLite and Postgres; never affects balances; state travels as htmx GET params. No new entities."}, {"id": "splitpro_rebuild_spec_and_prompt_move_expense", "label": "Move expense (\u00a75.2)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guided re-split as delete-and-recreate in one transaction: soft-delete original + create replacement with movedFromId; user must acknowledge the recalculated split. Reuses existing model plus one nullable self-reference - no new entities. CURRENCY_CONVERSION pairs and recurrence templates are not movable."}, {"id": "splitpro_rebuild_spec_and_prompt_golden_scenario", "label": "Golden Scenario", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One large deterministic regression fixture: 5 users, 6 groups, 230 transactions across 2 currencies; exercises split engine, balance view, settlements, conversions, and debt simplification together."}, {"id": "splitpro_rebuild_spec_and_prompt_reference_generator", "label": "Python reference generator", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Executable spec that emits golden_scenario.json (inputs) and golden_expected.json (outputs); the same construction + BalanceView math is ported into a Go test."}, {"id": "splitpro_rebuild_spec_and_prompt_testing_strategy", "label": "Testing strategy (coverage gate)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100% on split engine/balance view/debt simplification/currency math, >=90% overall; table-driven + property-based tests; data layer tested on both SQLite and Postgres; CI coverage gate."}, {"id": "splitpro_rebuild_spec_and_prompt_milestones", "label": "Build milestones M0-M11", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "Part 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Milestone-by-milestone build plan (scaffold, auth, friends, expenses+split, balances+activity, groups+move, currency, recurring+scheduler, PWA+push, i18n, optional modules, hardening) with acceptance criteria."}, {"id": "splitpro_rebuild_spec_and_prompt_deployment", "label": "Deployment (distroless + compose)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "go:embed assets; multi-stage Dockerfile to distroless; SQLite needs no DB container (volume for file+uploads); Postgres adds a compose service; goose migrations on boot; scheduler gated by SCHEDULER flag."}], "edges": [{"source": "splitpro_rebuild_spec_and_prompt_money_never_float", "target": "splitpro_rebuild_spec_and_prompt_expense", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": null, "weight": 1.0}, {"source": "splitpro_rebuild_spec_and_prompt_money_never_float", "target": "splitpro_rebuild_spec_and_prompt_split_engine", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": 