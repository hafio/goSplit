{"nodes": [{"id": "splitpro_rebuild_spec_and_prompt_parity_first", "label": "Parity first (drop OAuth/OIDC)", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything the current app does the rebuild does, except OAuth/OIDC sign-in which is deliberately removed (auth = magic-link + password); added: password auth, filtering, moving expenses."}, {"id": "splitpro_rebuild_spec_and_prompt_backend_heavy", "label": "Backend-heavy, GUI-light thin client", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All business logic on the server; the client is thin - HTML rendered on the server and swapped over the wire with minimal custom JS."}, {"id": "splitpro_rebuild_spec_and_prompt_money_never_float", "label": "Money is never a float", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store integer minor units as int64, format only at render; negative amounts allowed for refunds/corrections."}, {"id": "splitpro_rebuild_spec_and_prompt_balances_derived", "label": "Balances are derived, not stored", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a71 / \u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expenses + zero-sum ExpenseParticipant rows are the single source of truth; balances computed on the fly by a SQL VIEW. No stored balance tables."}, {"id": "splitpro_rebuild_spec_and_prompt_lightweight_selfhost", "label": "Lightweight & self-hostable", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Easy to implement, run, and self-host: a single static binary + SQLite (default) or PostgreSQL."}, {"id": "splitpro_rebuild_spec_and_prompt_chosen_stack", "label": "Chosen stack (Go+htmx+templ+Tailwind+Postgres)", "file_type": "rationale", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One static binary beats a Node+Next build: no client hydration/SPA framework, type-safe SQL matching the balance-view design, smaller deploy footprint - with no loss of features beyond the dropped OAuth/OIDC."}, {"id": "splitpro_rebuild_spec_and_prompt_templ", "label": "templ (type-safe HTML views)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_alpinejs", "label": "Alpine.js", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_tailwind", "label": "Tailwind CSS (standalone CLI)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_sqlc", "label": "sqlc (type-safe SQL)", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "splitpro_rebuild_spec_and_prompt_goose", "label": "goose migrations", "file_type": "concept", "source_file": "SPLITPRO_REBUILD_SPEC_AND_PROMPT.md"